# ============================================================
#  Document Q&A — environment
#  Copy this to ".env". Everything has a safe default, so the
#  app RUNS with an empty .env. Fill these in to switch each
#  piece from "demo mode" to the real thing.
# ============================================================

# --- Django ---
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave blank -> SQLite (works instantly, no setup).
# Set to a Postgres URL to use pgvector for real vector search:
#   postgres://user:pass@localhost:5432/docqa
DATABASE_URL=

# --- Embeddings ---
# EMBEDDING_BACKEND options:
#   local  -> a built-in hashing embedder (no API key, deterministic, for dev)
#   openai -> real OpenAI embeddings (needs OPENAI_API_KEY)
EMBEDDING_BACKEND=local
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Answering LLM ---
# LLM_BACKEND options:
#   echo      -> stub answer built from retrieved chunks (no key, for dev)
#   groq      -> fast + cheap open models via Groq (needs GROQ_API_KEY)  <-- great for launch
#   anthropic -> Claude answers (needs ANTHROPIC_API_KEY, highest quality)
#   openai    -> GPT answers (needs OPENAI_API_KEY)
# LLM_MODEL is optional — each backend has a sensible default
#   (groq -> llama-3.3-70b-versatile, anthropic -> claude-sonnet-4-6, openai -> gpt-4o-mini)
LLM_BACKEND=echo
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# --- Async processing ---
# CELERY_ENABLED=False -> documents are processed synchronously on upload
#   (simplest; fine for small files and local dev).
# CELERY_ENABLED=True  -> uses Celery + Redis (needs Redis running + a worker).
CELERY_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# --- Retrieval tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
